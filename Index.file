<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Megha's Creative World</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #fff8f5;
    color: #333;
}

header {
    background: #9c2766;
    color: white;
    padding: 22px 10px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 27px;
}

nav {
    background: #6f1948;
    padding: 12px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 8px;
    display: inline-block;
}

.hero {
    text-align: center;
    padding: 30px 15px;
    background: #ffe0ed;
}

.hero h2 {
    color: #9c2766;
}

.products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    padding: 15px;
}

.card {
    background: white;
    border-radius: 12px;
    padding: 12px;
    text-align: center;
    box-shadow: 0 2px 8px #ddd;
}

.card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
}

.card h3 {
    font-size: 17px;
}

.price {
    color: #9c2766;
    font-size: 19px;
    font-weight: bold;
}

button {
    background: #9c2766;
    color: white;
    border: none;
    padding: 11px;
    border-radius: 7px;
    width: 100%;
    cursor: pointer;
}

section {
    padding: 15px;
}

#order {
    background: #ffe0ed;
    margin: 15px;
    border-radius: 12px;
    padding: 18px;
}

input, textarea, select {
    width: 100%;
    padding: 12px;
    margin: 7px 0 13px;
    border: 1px solid #ccc;
    border-radius: 6px;
}

footer {
    background: #6f1948;
    color: white;
    text-align: center;
    padding: 20px;
}

@media (min-width: 650px) {
    .products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}
</style>
</head>

<body>

<header>
    <h1>🌸 Megha's Creative World 🌸</h1>
    <p>Handmade With Love ❤️</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#products">Products</a>
    <a href="#order">Order Now</a>
    <a href="#contact">Contact</a>
</nav>

<div class="hero" id="home">
    <h2>Welcome to My Handmade Store!</h2>
    <p>Unique Handmade Gifts & Beautiful Art</p>
    <p>🚚 Delivery available across Maharashtra</p>
</div>

<h2 style="text-align:center" id="products">🛍️ Our Products</h2>

<div class="products">

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Crochet+Bag"
        alt="Crochet Bag">
        <h3>Crochet Bag</h3>
        <p>Beautiful handmade bag</p>
        <p class="price">₹350</p>
        <button onclick="chooseProduct('Crochet Bag',350)">Order Now</button>
    </div>

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Keychain"
        alt="Crochet Keychain">
        <h3>Crochet Keychain</h3>
        <p>Cute handmade keychain</p>
        <p class="price">₹80</p>
        <button onclick="chooseProduct('Crochet Keychain',80)">Order Now</button>
    </div>

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Flower+Bouquet"
        alt="Flower Bouquet">
        <h3>Flower Bouquet</h3>
        <p>Special handmade bouquet</p>
        <p class="price">₹250</p>
        <button onclick="chooseProduct('Flower Bouquet',250)">Order Now</button>
    </div>

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Pipe+Cleaner"
        alt="Pipe Cleaner Bouquet">
        <h3>Pipe Cleaner Bouquet</h3>
        <p>Colourful handmade flowers</p>
        <p class="price">₹200</p>
        <button onclick="chooseProduct('Pipe Cleaner Bouquet',200)">Order Now</button>
    </div>

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Mat+Rangoli"
        alt="Mat Rangoli">
        <h3>Mat Rangoli</h3>
        <p>Beautiful woollen rangoli</p>
        <p class="price">₹300</p>
        <button onclick="chooseProduct('Mat Rangoli',300)">Order Now</button>
    </div>

    <div class="card">
        <img src="https://placehold.co/300x200/f8d7e5/7b2450?text=Aari+Work"
        alt="Aari Work">
        <h3>Aari Work</h3>
        <p>Custom embroidery designs</p>
        <p class="price">Price on request</p>
        <button onclick="chooseProduct('Aari Work',0)">Order Now</button>
    </div>

</div>

<section id="order">
    <h2>📦 Place Your Order</h2>
    <p>खाली तुमची माहिती भरा. ऑर्डर WhatsApp वर पाठवता येईल.</p>

    <form id="orderForm">
        <label>Your Name</label>
        <input type="text" id="customer" required>

        <label>Mobile Number</label>
        <input type="tel" id="mobile" pattern="[6-9][0-9]{9}"
        maxlength="10" required>

        <label>Select Product</label>
        <select id="product" required>
            <option value="">Choose Product</option>
            <option value="Crochet Bag">Crochet Bag</option>
            <option value="Crochet Keychain">Crochet Keychain</option>
            <option value="Flower Bouquet">Flower Bouquet</option>
            <option value="Pipe Cleaner Bouquet">Pipe Cleaner Bouquet</option>
            <option value="Mat Rangoli">Mat Rangoli</option>
            <option value="Aari Work">Aari Work</option>
        </select>

        <label>Quantity</label>
        <input type="number" id="quantity" min="1" value="1" required>

        <label>Full Delivery Address (Maharashtra)</label>
        <textarea id="address" rows="3" required></textarea>

        <label>Payment Preference</label>
        <select id="payment" required>
            <option value="UPI">UPI / Online Payment</option>
            <option value="Confirm payment details">Payment details confirm करायचे आहेत</option>
        </select>

        <button type="submit">Send Order on WhatsApp</button>
    </form>
</section>

<section id="contact" style="text-align:center">
    <h2>📞 Contact Us</h2>
    <p>Megha's Creative World</p>
    <p>Handmade Products & Custom Orders</p>
</section>

<footer>
    <p>© 2026 Megha's Creative World</p>
    <p>Made with ❤️ in Maharashtra</p>
</footer>

<script>
/*
  येथे तुझा WhatsApp नंबर टाक.
  91 नंतर 10 अंकी मोबाइल नंबर लिही.
  उदाहरण: 919876543210
*/
const WHATSAPP_NUMBER = "91XXXXXXXXXX";

function chooseProduct(name, price) {
    document.getElementById("product").value = name;
    document.getElementById("order").scrollIntoView({
        behavior: "smooth"
    });
}

document.getElementById("orderForm").addEventListener("submit", function(e) {
    e.preventDefault();

    if (WHATSAPP_NUMBER.includes("X")) {
        alert("कृपया कोडमध्ये तुझा WhatsApp नंबर टाक.");
        return;
    }

    const name = document.getElementById("customer").value.trim();
    const mobile = document.getElementById("mobile").value.trim();
    const product = document.getElementById("product").value;
    const quantity = document.getElementById("quantity").value;
    const address = document.getElementById("address").value.trim();
    const payment = document.getElementById("payment").value;

    const message =
        "NEW ORDER - Megha's Creative World%0A" +
        "Customer: " + encodeURIComponent(name) + "%0A" +
        "Mobile: " + encodeURIComponent(mobile) + "%0A" +
        "Product: " + encodeURIComponent(product) + "%0A" +
        "Quantity: " + encodeURIComponent(quantity) + "%0A" +
        "Address: " + encodeURIComponent(address) + "%0A" +
        "Payment Preference: " + encodeURIComponent(payment);

    window.open(
        "https://wa.me/" + WHATSAPP_NUMBER + "?text=" + message,
        "_blank"
    );
});
</script>

</body>
</html>
